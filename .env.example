# Copy to .env for local development: cp .env.example .env
# .env is gitignored. In deployed environments, set these as real
# environment variables (DB_PASSWORD from a secret store); no .env is used.

PORT=8082

# Matches docker-compose.yml
DB_HOST=localhost
DB_PORT=5433
DB_NAME=players
DB_USER=appuser
DB_PASSWORD=mypassword
